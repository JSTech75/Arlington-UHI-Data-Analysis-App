import type { Express } from "express";
import type { Server } from "http";
import { storage } from "./storage";
import { api } from "@shared/routes";

export async function registerRoutes(
  httpServer: Server,
  app: Express
): Promise<Server> {
  
  // API Routes
  app.get(api.tracts.list.path, async (_req, res) => {
    const tracts = await storage.getTracts();
    res.json(tracts);
  });

  app.get(api.analysis.list.path, async (_req, res) => {
    const results = await storage.getAnalysisResults();
    res.json(results);
  });

  return httpServer;
}

