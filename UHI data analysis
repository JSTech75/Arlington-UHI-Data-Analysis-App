import { useQuery } from "@tanstack/react-query";
import { api } from "@shared/routes";

export function useTracts() {
  return useQuery({
    queryKey: [api.tracts.list.path],
    queryFn: async () => {
      const res = await fetch(api.tracts.list.path);
      if (!res.ok) throw new Error("Failed to fetch tract data");
      return api.tracts.list.responses[200].parse(await res.json());
    },
  });
}

export function useAnalysis() {
  return useQuery({
    queryKey: [api.analysis.list.path],
    queryFn: async () => {
      const res = await fetch(api.analysis.list.path);
      if (!res.ok) throw new Error("Failed to fetch analysis results");
      return api.analysis.list.responses[200].parse(await res.json());
    },
  });
}
