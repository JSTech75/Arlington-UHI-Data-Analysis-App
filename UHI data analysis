import { MapContainer, TileLayer, CircleMarker, Popup, Tooltip as LeafletTooltip, ScaleControl, ZoomControl } from 'react-leaflet';
import { useTracts } from "@/hooks/use-data";
import { Loader2, Layout, Maximize2, MousePointer2 } from "lucide-react";
import { HeatMapLegend } from "@/components/HeatMapLegend";
import { useState } from "react";
import { Button } from "@/components/ui/button";

export default function InteractiveMap() {
  const { data: tracts, isLoading } = useTracts();
  const [isSplitView, setIsSplitView] = useState(false);
  const [activeLayer, setActiveLayer] = useState<'heat' | 'vulnerability'>('heat');
  const [mousePos, setMousePos] = useState<{ lat: number; lng: number } | null>(null);

  if (isLoading) {
    return (
      <div className="flex h-screen w-full flex-col items-center justify-center bg-slate-50">
        <Loader2 className="h-10 w-10 animate-spin text-primary mb-4" />
        <span className="font-medium text-slate-600">Loading Map Data...</span>
      </div>
    );
  }

  const getColor = (temp: number) => {
    if (temp > 40) return '#dc2626';
    if (temp > 35) return '#f97316';
    if (temp > 30) return '#eab308';
    if (temp > 28) return '#84cc16';
    return '#10b981';
  };

  const getVulnerabilityColor = (score: number) => {
    const colors = ['#f1f5f9', '#cbd5e1', '#64748b', '#334155', '#0f172a'];
    return colors[score - 1] || colors[0];
  };

  const getRadius = (score: number) => {
    return 10 + (score * 4);
  };

  const center: [number, number] = [38.8816, -77.1120];

  const MapView = ({ type, showTitle = false }: { type: 'heat' | 'vulnerability', showTitle?: boolean }) => (
    <div className="relative h-full w-full">
      {showTitle && (
        <div className="absolute top-4 left-1/2 -translate-x-1/2 z-[1000] bg-white/90 px-4 py-2 rounded-full shadow-md border font-bold">
          {type === 'heat' ? 'Surface Temperature View' : 'Vulnerability Index View'}
        </div>
      )}
      <MapContainer 
        center={center} 
        zoom={13} 
        zoomControl={false}
        className="h-full w-full"
      >
        <TileLayer
          attribution='&copy; CARTO'
          url="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"
        />
        <ZoomControl position="bottomright" />
        <ScaleControl position="bottomleft" />
        
        {tracts?.map((tract) => {
            const coords = JSON.parse(tract.coordinates) as [number, number];
            return (
                <CircleMarker
                    key={tract.id}
                    center={coords}
                    radius={getRadius(tract.vulnerabilityScore)}
                    pathOptions={{
                        fillColor: type === 'heat' ? getColor(tract.meanLstCelsius) : getVulnerabilityColor(tract.vulnerabilityScore),
                        color: 'white',
                        weight: 2,
                        opacity: 1,
                        fillOpacity: 0.8
                    }}
                >
                    <Popup>
                        <div className="p-2 min-w-[150px]">
                            <h3 className="font-bold text-lg mb-2">{tract.tractId}</h3>
                            <div className="space-y-1 text-sm">
                                <div className="flex justify-between">
                                    <span className="text-slate-500">Temp:</span>
                                    <span className="font-mono font-bold">{tract.meanLstCelsius}°C</span>
                                </div>
                                <div className="flex justify-between">
                                    <span className="text-slate-500">Vulnerability:</span>
                                    <span className="font-mono font-bold">{tract.vulnerabilityScore}/5</span>
                                </div>
                            </div>
                        </div>
                    </Popup>
                </CircleMarker>
            )
        })}
      </MapContainer>
    </div>
  );

  return (
    <div className="h-[calc(100vh-64px)] w-full flex flex-col">
      {/* Google Maps Style Control Bar */}
      <div className="bg-white border-b px-4 py-2 flex items-center justify-between shadow-sm z-[1100]">
        <div className="flex items-center gap-2">
          <Button 
            variant={!isSplitView ? "default" : "outline"} 
            size="sm" 
            onClick={() => setIsSplitView(false)}
            className="gap-2"
          >
            <Maximize2 className="h-4 w-4" />
            Single View
          </Button>
          <Button 
            variant={isSplitView ? "default" : "outline"} 
            size="sm" 
            onClick={() => setIsSplitView(true)}
            className="gap-2"
          >
            <Layout className="h-4 w-4" />
            Split Screen
          </Button>
        </div>
        
        <div className="flex items-center gap-4 text-sm font-mono text-slate-500 bg-slate-50 px-3 py-1 rounded border">
          <MousePointer2 className="h-3 w-3" />
          <span>Arlington, VA</span>
          <span className="hidden sm:inline">38.88°N, 77.11°W</span>
        </div>
      </div>

      <div className="flex-1 flex overflow-hidden">
        {!isSplitView ? (
          <div className="relative w-full h-full">
            <div className="absolute top-4 left-4 z-[1000] bg-white p-2 rounded-lg shadow-lg border space-y-2">
              <Button 
                variant={activeLayer === 'heat' ? "default" : "ghost"} 
                className="w-full justify-start text-xs"
                onClick={() => setActiveLayer('heat')}
              >
                🌡️ Heat Layer
              </Button>
              <Button 
                variant={activeLayer === 'vulnerability' ? "default" : "ghost"} 
                className="w-full justify-start text-xs"
                onClick={() => setActiveLayer('vulnerability')}
              >
                👥 Vulnerability
              </Button>
            </div>
            <MapView type={activeLayer} />
          </div>
        ) : (
          <>
            <div className="w-1/2 h-full border-r">
              <MapView type="heat" showTitle />
            </div>
            <div className="w-1/2 h-full">
              <MapView type="vulnerability" showTitle />
            </div>
          </>
        )}
      </div>

      <HeatMapLegend />
    </div>
  );
}
