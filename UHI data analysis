// === TABLE DEFINITIONS ===

// Data for each Census Tract (Simulated for the project)
export const tracts = pgTable("tracts", {
  id: serial("id").primaryKey(),
  tractId: text("tract_id").notNull(),
  imperviousSurfacePct: real("impervious_surface_pct").notNull(),
  treeCanopyPct: real("tree_canopy_pct").notNull(),
  vulnerabilityScore: integer("vulnerability_score").notNull(), // 1-5 scale
  meanLstCelsius: real("mean_lst_celsius").notNull(),
  population: integer("population").notNull(),
  medianIncome: integer("median_income").notNull(),
  coordinates: text("coordinates").notNull(), // JSON string of [lat, lng] for map center
});

// Analysis results (Regression coefficients, etc.)
export const analysisResults = pgTable("analysis_results", {
  id: serial("id").primaryKey(),
  variable: text("variable").notNull(), // e.g., "Tree Canopy", "Impervious Surface"
  coefficient: real("coefficient").notNull(),
  interpretation: text("interpretation").notNull(),
});

// === SCHEMAS ===
export const insertTractSchema = createInsertSchema(tracts).omit({ id: true });
export const insertAnalysisSchema = createInsertSchema(analysisResults).omit({ id: true });

// === TYPES ===
export type Tract = typeof tracts.$inferSelect;
export type InsertTract = z.infer<typeof insertTractSchema>;

export type AnalysisResult = typeof analysisResults.$inferSelect;
export type InsertAnalysisResult = z.infer<typeof insertAnalysisSchema>;

